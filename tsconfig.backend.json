{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "outDir": "server_build",
    "rootDir": "server",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["server/**/*.ts"]
}